{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "peakadex-satellite-tiles",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true
  },
  // Daily key-expiry check at 09:00 UTC. See the scheduled() handler.
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  // Custom domain — Cloudflare provisions the cert and the DNS record itself.
  // Comment this out to deploy to the *.workers.dev subdomain instead.
  "routes": [
    {
      "pattern": "tiles.peakadex.com",
      "custom_domain": true
    }
  ],
  "vars": {
    // Licensed ArcGIS Location Platform imagery endpoint. Taken from the
    // Basemap Styles service (`styles/v2/styles/arcgis/imagery` → sources →
    // tiles), not guessed — that style is the only place the real URL is
    // published. Same {z}/{y}/{x} row/col order as the legacy service, and
    // 256 px tiles, so no client change was needed to adopt it.
    "UPSTREAM_TEMPLATE": "https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",

    // Expiry of ARCGIS_API_KEY. Update this whenever the key is rotated —
    // /health turns "ok": false 30 days out and 503 once past it.
    "KEY_EXPIRES_AT": "2027-09-21",

    // Where the daily expiry alert goes. RESEND_API_KEY is a secret.
    //
    // ALERT_FROM matches the app's own RESEND_FROM on Railway. It is hola@,
    // not the noreply@ that some docs still mention: the sender has to be one
    // the Resend domain actually has verified, and a wrong one fails the same
    // silent way a bad key does — 200-with-an-error-body, never an exception.
    "ALERT_EMAIL": "santitrenchs@gmail.com",
    "ALERT_FROM": "Peakadex <hola@mail.peakadex.com>"
  }
  // ARCGIS_API_KEY is a SECRET, never a var — set it with:
  //   npx wrangler secret put ARCGIS_API_KEY
}
